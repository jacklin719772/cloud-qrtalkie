{
  "_comment": "AI 助手 v2 联网搜索代理配置。复制为 config/ai-search.json 后修改。active: 当前服务商 id（none = 禁用）。Key 一律放服务器 .env（AI_SEARCH_KEY_*），不写入本文件。",
  "active": "none",
  "timeoutMs": 8000,
  "providers": {
    "bocha": {
      "url": "https://api.bochaai.com/v1/web-search",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "auth": { "type": "bearerHeader", "envKey": "AI_SEARCH_KEY_BOCHA" },
      "body": { "query": "{{query}}", "summary": true, "count": "{{count}}" },
      "responseMap": { "resultsPath": "data.webPages.value", "title": "name", "url": "url", "snippet": "summary" }
    },
    "tavily": {
      "url": "https://api.tavily.com/search",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "auth": { "type": "bodyField", "field": "api_key", "envKey": "AI_SEARCH_KEY_TAVILY" },
      "body": { "query": "{{query}}", "max_results": "{{count}}", "search_depth": "basic" },
      "responseMap": { "resultsPath": "results", "title": "title", "url": "url", "snippet": "content" }
    },
    "serpapi": {
      "url": "https://serpapi.com/search.json",
      "method": "GET",
      "auth": { "type": "queryParam", "param": "api_key", "envKey": "AI_SEARCH_KEY_SERPAPI" },
      "query": { "engine": "google", "q": "{{query}}", "num": "{{count}}" },
      "responseMap": { "resultsPath": "organic_results", "title": "title", "url": "link", "snippet": "snippet" }
    }
  }
}
