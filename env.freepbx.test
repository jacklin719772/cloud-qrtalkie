# ===== ECard Call / Asterisk WebRTC caller side =====

# 浏览器 JsSIP 连接 Asterisk 的 WebSocket 地址。
ECARD_ASTERISK_WEBRTC_WSS_URL=wss://pbx.qrtalkie.org:8089/ws

# Asterisk WebRTC/Web 账号注册域。
ECARD_ASTERISK_WEBRTC_DOMAIN=pbx.qrtalkie.org

# 所有 ecard WebRTC/Web 主叫账号使用的统一注册密码。
# 敏感配置：后端私有，禁止输出到日志。
ECARD_ASTERISK_WEBRTC_SHARED_PASSWORD=change-me-in-real-env

# Asterisk 媒体公网 IP，供旧版 SDP patch / 媒体地址修正使用。
ECARD_ASTERISK_WEBRTC_SIP_SERVER_PUBLIC_IP=35.221.190.216

# 是否启用 ecard 语音呼叫。
ECARD_ASTERISK_WEBRTC_ENABLE_VOICE_CALL=true

# 是否启用 ecard 视频呼叫。
ECARD_ASTERISK_WEBRTC_ENABLE_VIDEO_CALL=true


# ===== ECard Call / Flexisip SIP callee side =====

# ecard 被叫 SIP 账号所在 Flexisip 域。
# 后续代码用数据库中的 sipAccount 生成：sip:<sipAccount>@<ECARD_FLEXISIP_SIP_DOMAIN>
ECARD_FLEXISIP_SIP_DOMAIN=sip.qrtalkie.org


# ===== ECard WebRTC ICE / TURN =====

# 浏览器 WebRTC 使用的 ICE servers。
ECARD_WEBRTC_ICE_SERVERS=stun:relay.qrtalkie.org:3478,turn:relay.qrtalkie.org:3478

# TURN 用户名，敏感配置，后续可改为短期凭据。
ECARD_WEBRTC_TURN_USERNAME=qrtalkie

# TURN 密码，敏感配置，禁止输出到日志。
ECARD_WEBRTC_TURN_PASSWORD=change-me-in-real-env

# STUN 服务器。
ECARD_WEBRTC_STUN_SERVER=stun:relay.qrtalkie.org:3478
