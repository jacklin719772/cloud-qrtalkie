{
  "name": "default-webrtc-template",
  "description": "Default WebRTC PJSIP extension template based on FreePBX standard extension",
  "sourceExtension": "${FREEPBX_WEBRTC_TEMPLATE_EXTENSION}",
  "fallbackSourceExtension": "${FREEPBX_WEBRTC_TEMPLATE_FALLBACK_EXTENSION}",
  "identity": {
    "displayNamePrefix": "${FREEPBX_WEBRTC_DISPLAY_NAME_PREFIX}",
    "emailDomain": "${FREEPBX_WEBRTC_EMAIL_DOMAIN}",
    "context": "${FREEPBX_WEBRTC_CONTEXT}",
    "tech": "pjsip",
    "vmEnable": false,
    "maxContacts": "${FREEPBX_WEBRTC_MAX_CONTACTS}",
    "mediaAddress": "${FREEPBX_WEBRTC_MEDIA_ADDRESS}",
    "transport": "${FREEPBX_WEBRTC_TRANSPORT}"
  },
  "freepbxWebForm": {
    "devinfo_transport": "${FREEPBX_WEBRTC_TRANSPORT}",
    "devinfo_disallow": "${FREEPBX_WEBRTC_DISALLOW_CODECS}",
    "devinfo_allow": "${FREEPBX_WEBRTC_FORM_ALLOW_CODECS}",
    "devinfo_media_address": "${FREEPBX_WEBRTC_MEDIA_ADDRESS}",
    "devinfo_direct_media": "no",
    "devinfo_aggregate_mwi": "yes",
    "devinfo_avpf": "yes",
    "devinfo_rtcp_mux": "yes",
    "devinfo_bundle": "yes",
    "devinfo_icesupport": "yes",
    "devinfo_media_use_received_transport": "yes",
    "devinfo_media_encryption": "dtls",
    "devinfo_media_encryption_optimistic": "yes",
    "devinfo_timers": "no",
    "devinfo_refer_blind_progress": "yes",
    "devinfo_sendrpid": "pai",
    "devinfo_mailbox": "",
    "devinfo_remove_existing": "yes",
    "dtls_enable": "yes",
    "dtls_verify": "fingerprint",
    "dtls_setup": "actpass",
    "dtls_rekey": "0",
    "dtls_auto_generate_cert": "1",
    "callwaiting": "enabled",
    "cwtone": "enabled",
    "vm": "disabled"
  },
  "endpointGeneratedExpected": {
    "transport": "${FREEPBX_WEBRTC_TRANSPORT}",
    "disallow": "${FREEPBX_WEBRTC_DISALLOW_CODECS}",
    "allow": "${FREEPBX_WEBRTC_ALLOW_CODECS}",
    "context": "${FREEPBX_WEBRTC_CONTEXT}",
    "media_address": "${FREEPBX_WEBRTC_MEDIA_ADDRESS}",
    "direct_media": "no",
    "aggregate_mwi": "yes",
    "use_avpf": "yes",
    "rtcp_mux": "yes",
    "bundle": "yes",
    "ice_support": "yes",
    "media_use_received_transport": "yes",
    "media_encryption": "dtls",
    "timers": "no",
    "media_encryption_optimistic": "yes",
    "refer_blind_progress": "yes",
    "send_pai": "yes",
    "dtls_verify": "fingerprint",
    "dtls_setup": "actpass",
    "dtls_auto_generate_cert": "yes"
  },
  "endpointCustomPostOverlay": {
    "allow_unauthenticated_options": "yes",
    "rtp_timeout": "0",
    "rtp_timeout_hold": "0",
    "asymmetric_rtp_codec": "yes"
  }
}
