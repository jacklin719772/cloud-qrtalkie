# 前端首页链接
VITE_HOME_PAGE_URL=https://www.qrtalkie.org
VITE_WEBRTC_DOMAIN=pbx.qrtalkie.org
VITE_WEB_ACCOUNT_DEFAULT_PASSWORD=Lin1971wn719772

# 呼叫中心访客访问
CALL_CENTER_BASE_URL=http://127.0.0.1:3001
VITE_CALL_CENTER_BASE_URL=http://127.0.0.1:3001

# 门禁系统访客访问
ACCESS_BASE_URL=http://127.0.0.1:3001
VITE_ACCESS_BASE_URL=http://127.0.0.1:3001

# ===== ECard Call / Asterisk WebRTC caller side =====

# 浏览器 JsSIP 连接 Asterisk 的 WebSocket 地址。
ECARD_ASTERISK_WEBRTC_WSS_URL=wss://pbx.qrtalkie.org:8089/ws

# Asterisk WebRTC/Web 账号注册域。
ECARD_ASTERISK_WEBRTC_DOMAIN=pbx.qrtalkie.org

# 所有 ecard WebRTC/Web 主叫账号使用的统一注册密码。
# 敏感配置：后端私有，禁止输出到日志。
ECARD_ASTERISK_WEBRTC_SHARED_PASSWORD=change-me-in-real-env

# Asterisk 媒体公网 IP，供旧版 SDP patch / 媒体地址修正使用。
ECARD_ASTERISK_WEBRTC_SIP_SERVER_PUBLIC_IP=35.221.190.216

# 是否启用 ecard 语音呼叫。
ECARD_ASTERISK_WEBRTC_ENABLE_VOICE_CALL=true

# 是否启用 ecard 视频呼叫。
ECARD_ASTERISK_WEBRTC_ENABLE_VIDEO_CALL=true


# ===== ECard Call / Flexisip SIP callee side =====

# ecard 被叫 SIP 账号所在 Flexisip 域。
# 后续代码用数据库中的 sipAccount 生成：sip:<sipAccount>@<ECARD_FLEXISIP_SIP_DOMAIN>
ECARD_FLEXISIP_SIP_DOMAIN=sip.qrtalkie.org


# ===== ECard WebRTC ICE / TURN =====

# 浏览器 WebRTC 使用的 ICE servers。
ECARD_WEBRTC_ICE_SERVERS=stun:relay.qrtalkie.org:3478,turn:relay.qrtalkie.org:3478

# TURN 用户名，敏感配置，后续可改为短期凭据。
ECARD_WEBRTC_TURN_USERNAME=qrtalkie

# TURN 密码，敏感配置，禁止输出到日志。
ECARD_WEBRTC_TURN_PASSWORD=change-me-in-real-env

# STUN 服务器。
ECARD_WEBRTC_STUN_SERVER=stun:relay.qrtalkie.org:3478


# ===== Unified Push Gateway (phase 1 scaffold) =====

# Push Gateway 总开关；阶段 1 默认关闭。
PUSH_GATEWAY_ENABLED=false

# Push Gateway 真实发送测试总开关；默认关闭，只允许 dry-run。
PUSH_GATEWAY_LIVE_TEST_ENABLED=false

# Flexisip external-push-uri 调用 Push Gateway 时使用的共享密钥。
# 敏感配置：后端私有，禁止输出到日志。
PUSH_GATEWAY_SECRET=

# Push Gateway 鉴权请求头名称。
PUSH_GATEWAY_SECRET_HEADER=x-push-gateway-secret

# APNs provider 开关与证书/密钥配置。
APNS_ENABLED=false
APNS_LIVE_TEST_ENABLED=false
APNS_ENV=production
APNS_AUTH_MODE=pem
APNS_CERT_PATH=/etc/flexisip/apn/com.qrtalkie.qrtalkie.prod.pem
APNS_VOIP_CERT_PATH=/etc/flexisip/apn/com.qrtalkie.qrtalkie.voip.prod.pem
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_VOIP_BUNDLE_ID=
APNS_KEY_PATH=

# FCM provider 开关与服务账号配置。
FCM_ENABLED=false
FCM_LIVE_TEST_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=

# JPush provider（大陆 Android 备选）配置。
JPUSH_ENABLED=false
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_API_URL=https://api.jpush.cn/v3/push

# Live test helper values for local Gateway verification.
PUSH_LIVE_TEST_TOKEN=
PUSH_LIVE_TEST_APP_ID=
PUSH_LIVE_TEST_FROM_URI=
PUSH_LIVE_TEST_TO_URI=
